# Copie para .env (uso local) ou cole as mesmas linhas nos Secrets do Streamlit Cloud
# (formato TOML lá: NOME = "valor"). NUNCA commite o .env real em nenhum repositório.

OPENAI_API_KEY=sk-sua-chave-aqui

# Histórico de 30 dias sem repetir produto, salvo na branch "dados" do seu repositório.
# GITHUB_TOKEN: token "fine-grained" com permissão Contents: Read and write só neste repo.
# GITHUB_REPO: usuario/nome-do-repositorio (ex: kav-mkt/kav-mkt).
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH_DADOS=dados

# Opcional: senha simples para proteger o app quando publicado com URL pública.
APP_PASSWORD=

# Meta Ads / Instagram (tokens por cliente, gerados no Business Manager do cliente)
# Padrão: META_ACCESS_TOKEN__<SLUG_DO_CLIENTE_EM_MAIUSCULO>
META_ACCESS_TOKEN__NN_RESTAURANTE=

# Google Ads (futuro — centralizado na MCC Kav 790-737-7766)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=7907377766

# Opcionais: modelos e qualidade.
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high
